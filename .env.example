# Prisma - PostgreSQL connection string
# See: https://pris.ly/d/connection-strings
# IMPORTANT: If your password contains special characters (e.g., @, #, $, %, &),
# they MUST be URL-encoded. Replace @ with %40, # with %23, etc.
# Example: password "pass@word" → postgresql://postgres:pass%40word@localhost:5432/dms?schema=public
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/dms?schema=public"

# Server port
PORT=3001

# JWT authentication
JWT_SECRET=your-jwt-secret-here-generate-with-openssl-rand-hex-64
JWT_EXPIRATION=30d

# Secret key for signed file URLs
FILE_SECRET=your-file-secret-here-generate-with-openssl-rand-hex-64

# Public API URL (used for callbacks and internal references)
API_URL=http://localhost:3001/api

# OnlyOffice Document Server URL (optional; used by the healthcheck and online editing)
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_SECRET=your-onlyoffice-secret-here
ONLYOFFICE_CALLBACK_HOST=http://host.docker.internal:3001
