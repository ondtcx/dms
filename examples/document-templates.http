### 7. Crear documento - Reporte de Incidente
POST {{baseUrl}}/documents/from-template
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "templateId": 7,
  "formData": {
    "numero_incidente": "INC-2024-0042",
    "fecha_incidente": "2024-01-23",
    "hora_incidente": "14:30",
    "lugar": "Centro de Datos - Rack B-15",
    "reportado_por": "Carlos Rodríguez - Técnico de Infraestructura",
    "tipo_incidente": "Falla de Hardware - Servidor",
    "descripcion": "Se detectó falla en el servidor de base de datos principal (DB-PROD-01). El servidor dejó de responder a peticiones y se reinició automáticamente. Los logs muestran errores de disco duro.",
    "personas_involucradas": "Carlos Rodríguez (reportó), Juan Pérez (respondió), María García (coordinó)",
    "acciones_tomadas": "1. Se aisló el servidor del pool de producción\n2. Se activó servidor de respaldo (DB-PROD-02)\n3. Se realizó diagnóstico del disco duro\n4. Se programó reemplazo de disco duro para 24/01/2024\n5. Se notificó a los usuarios del breve periodo de degradación del servicio",
    "seguimiento": "Monitorear el rendimiento del servidor de respaldo. Programar mantenimiento preventivo de los demás servidores. Revisar políticas de respaldo de datos."
  },
  "filename": "reporte-incidente-2024-0042.json",
  "description": "Reporte de incidente - Falla servidor DB-PROD-01",
  "isPublic": false
}

